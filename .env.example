# Values are quoted so that `set -a; source .env; set +a` works with any shell.
# Placeholders such as "change-me" and URLs containing <...> are rejected at startup: replace them.

# ===== MCP Gateway (Console -> AgentBase -> MCP Gateway -> gateway detail page -> connector) =====
# Single connector (read by list_tools.py; agent.py falls back to it when MCP_GATEWAY_URLS is empty):
MCP_GATEWAY_URL="https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/<connector>"
# Several connectors (read by agent.py), comma-separated. Tool names must be unique across connectors:
MCP_GATEWAY_URLS="https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/<connector>"

# ===== Inbound Auth: must MATCH the gateway configuration =====
# iam (default) | jwt | none (dev only, when the gateway uses "No authorization")
GATEWAY_AUTH="iam"

# --- GATEWAY_AUTH=iam: IAM service account (Console -> IAM -> Service accounts). Do NOT commit! ---
# Outside AgentBase Runtime these variables are NOT injected automatically.
GREENNODE_CLIENT_ID="change-me"
GREENNODE_CLIENT_SECRET="change-me"

# --- GATEWAY_AUTH=jwt: JWT from your IdP (the gateway verifies it via Discovery URL / JWKS) ---
# GATEWAY_JWT="change-me"
# Or a file that is re-read on every request (works with a token-refresh script):
# GATEWAY_JWT_FILE="~/.config/my-idp/token.jwt"

# ===== LLM: only needed for agent.py (GreenNode AI Platform, OpenAI-compatible) =====
LLM_API_KEY="change-me"
LLM_BASE_URL="https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1"
LLM_MODEL="z-ai/glm-5.3-flash"
# Any other OpenAI-compatible LLM works: change the three variables above.

# ===== Logging (agent.py) =====
# DEBUG | INFO (default) | WARNING | ERROR. INFO prints the loaded tools and the token usage of each run.
LOG_LEVEL="INFO"
