# ===== MCP Gateway (lấy ở Console → AgentBase → MCP Gateway → trang chi tiết gateway → connector) =====
# Một connector (dùng cho list_tools.py):
MCP_GATEWAY_URL=https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/<connector>
# Nhiều connector (dùng cho agent.py), cách nhau dấu phẩy:
MCP_GATEWAY_URLS=https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/stock

# ===== Inbound Auth — phải KHỚP cấu hình trên gateway =====
# iam (mặc định) | jwt | none (chỉ dev, khi gateway chọn "No authorization")
GATEWAY_AUTH=iam

# --- GATEWAY_AUTH=iam: IAM service account (Console → IAM → Service accounts). KHÔNG commit! ---
# Ngoài AgentBase Runtime, các biến này KHÔNG được tự inject.
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=

# --- GATEWAY_AUTH=jwt: JWT từ IdP của bạn (gateway verify qua Discovery URL / JWKS) ---
# GATEWAY_JWT=eyJ...
# GATEWAY_JWT_FILE=~/.config/my-idp/token.jwt   # đọc lại mỗi lần gọi (hợp với script refresh)

# ===== LLM — chỉ cần cho agent.py (GreenNode AI Platform, OpenAI-compatible) =====
LLM_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash
# Có thể dùng bất kỳ LLM OpenAI-compatible nào khác: đổi 3 biến trên.
