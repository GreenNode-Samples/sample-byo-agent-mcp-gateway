# ===== MCP Gateway (get it from Console → AgentBase → MCP Gateway → gateway detail page → connector) =====
# Single connector (used by list_tools.py):
MCP_GATEWAY_URL=https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/<connector>
# Multiple connectors (used by agent.py), comma-separated:
MCP_GATEWAY_URLS=https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/stock

# ===== Inbound Auth — must MATCH the gateway configuration =====
# iam (default) | jwt | none (dev only, when the gateway uses "No authorization")
GATEWAY_AUTH=iam

# --- GATEWAY_AUTH=iam: IAM service account (Console → IAM → Service accounts). Do NOT commit! ---
# Outside AgentBase Runtime, these variables are NOT injected automatically.
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=

# --- GATEWAY_AUTH=jwt: JWT from your IdP (the gateway verifies it via Discovery URL / JWKS) ---
# GATEWAY_JWT=eyJ...
# GATEWAY_JWT_FILE=~/.config/my-idp/token.jwt   # re-read on every call (works with a refresh script)

# ===== LLM — only needed for agent.py (GreenNode AI Platform, OpenAI-compatible) =====
LLM_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash
# You can use any other OpenAI-compatible LLM: change the 3 variables above.
