{
  "mcpServers": {
    "agentbase-stock": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.14.3",
        "https://gw-<gateway>-<id>.agentbase-gateway.aiplatform.vngcloud.vn/stock",
        "--transport",
        "http-only",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer <paste token from: python scripts/print_token.py>"
      }
    }
  }
}
